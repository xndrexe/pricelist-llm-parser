# Адрес локального Ollama-сервера. Используется только в режиме --llm.
# Без --llm парсер работает на эвристиках и переменная не нужна.
PRICELIST_OLLAMA_HOST=http://localhost:11434

# Имя модели для LLM-разметки колонок. По умолчанию qwen2.5:7b-instruct —
# быстрая, неплохо ловит русские заголовки. Можно подменить на любую
# instruct-модель, которую вы скачали через `ollama pull`.
PRICELIST_OLLAMA_MODEL=qwen2.5:7b-instruct
